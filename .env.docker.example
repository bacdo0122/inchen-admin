# Copy sang `.env` ở GỐC REPO trên VPS rồi điền giá trị thật:  cp .env.docker.example .env
# File này vừa dùng để compose nội suy (${...}), vừa được nạp vào container api.
# CHÚ Ý: DATABASE_URL / NODE_ENV / PORT do docker-compose.yml tự set — không khai báo ở đây.

# ── Postgres (container db) ────────────────────────────────
POSTGRES_USER=inchem
POSTGRES_DB=inchem
# Sinh chuỗi mạnh: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Auth ───────────────────────────────────────────────────
# openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Tài khoản admin khởi tạo (chỉ dùng khi chạy seed)
ADMIN_EMAIL=admin@inchemminhhien.com.vn
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị Minh Hiền

# ── CORS: domain thật của web + admin, phân tách bằng dấu phẩy ──
CORS_ORIGINS=https://inchemminhhien.com.vn,https://www.inchemminhhien.com.vn,https://admin.inchemminhhien.com.vn

# ── Email lead (Resend) ────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM="Website Minh Hiền <no-reply@inchemminhhien.com.vn>"
MAIL_TO=hienminh2011@gmail.com

# ── Upload ảnh (Cloudflare R2) ─────────────────────────────
R2_ACCOUNT_ID=
R2_BUCKET=inchem-uploads
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_FOLDER=inchem
R2_PUBLIC_URL=
